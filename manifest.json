{
  "schemaVersion": 1,
  "id": "io.github.iboard.sound-source",
  "name": "Sound Source",
  "version": "1.0.3",
  "author": "iboard",
  "license": "Apache-2.0",
  "repository": "https://github.com/iboard/sound-source",
  "homepage": "https://github.com/iboard/sound-source",
  "description": "Names the application that just started playing audio, in a popup.",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "panel": "SoundPopup.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Sound Source",
    "description": "Toggle the popup; right-click for setup",
    "category": "Status",
    "allowMultiple": false,
    "defaultSection": "center"
  }
}
